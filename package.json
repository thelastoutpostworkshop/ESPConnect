{
  "name": "espconnect",
  "productName": "ESPConnect",
  "private": true,
  "version": "1.1.25",
  "type": "module",
  "description": "Browser-based control center for ESP32 and ESP8266 boards",
  "main": "electron/main.cjs",
  "author": "The Last Outpost Workshop",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fatfs": "vitest run src/tests/fatfs.fixture.test.ts",
    "test:e2e": "playwright test",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge release",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "buffer": "^6.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "tasmota-webserial-esptool": "7.3.10",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.4",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^43.2.0",
    "patch-package": "^8.0.1",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.2"
  }
}
